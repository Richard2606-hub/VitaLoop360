# Copy to .env locally. Never commit .env or send keys to the browser.
# A configured endpoint does not itself prove AMD hardware or Gemma availability.
# Confirm the model identifier and base URL with your provider.
VITALOOP_BASE_URL=
VITALOOP_API_KEY=
VITALOOP_MODEL=
VITALOOP_PROVIDER=AMD-compatible endpoint (operator configured)
VITALOOP_TIMEOUT_SECONDS=20
# USD per million tokens. Blank = cost unavailable; zero = explicitly free.
VITALOOP_INPUT_PRICE_PER_MILLION=
VITALOOP_OUTPUT_PRICE_PER_MILLION=
# Optional durable ledger directory; defaults to ./data next to run.py.
# VITALOOP_DATA_DIR=
